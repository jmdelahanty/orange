# Writes the build-time source stamp (src/build_info.h) for the tree being built.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<generated .cpp> -P write_build_info.cmake
# Runs on every build; the output is rewritten only when its content changes, so
# an unchanged stamp recompiles nothing.

function(git_output out_var)
    execute_process(COMMAND git -C "${SOURCE_DIR}" ${ARGN}
                    OUTPUT_VARIABLE value
                    RESULT_VARIABLE result
                    ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        set(value "")
    endif()
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

git_output(commit rev-parse HEAD)
git_output(commit_short rev-parse --short HEAD)
git_output(branch rev-parse --abbrev-ref HEAD)
git_output(describe describe --always --dirty --tags)
git_output(tracked_status status --porcelain --untracked-files=no)

if(commit STREQUAL "")
    set(available "false")
    set(dirty "false")
    set(dirty_known "false")
else()
    set(available "true")
    set(dirty_known "true")
    if(tracked_status STREQUAL "")
        set(dirty "false")
    else()
        set(dirty "true")
    endif()
endif()

foreach(var commit commit_short branch describe)
    string(REPLACE "\\" "\\\\" ${var} "${${var}}")
    string(REPLACE "\"" "\\\"" ${var} "${${var}}")
endforeach()

set(content "// Generated by cmake/write_build_info.cmake on every build; do not edit.
#include \"build_info.h\"

namespace orange::build_info {

const BuildStamp& stamp()
{
    static const BuildStamp value{
        ${available},
        \"${commit}\",
        \"${commit_short}\",
        \"${branch}\",
        \"${describe}\",
        ${dirty_known},
        ${dirty},
    };
    return value;
}

}  // namespace orange::build_info
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
else()
    set(previous "")
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
