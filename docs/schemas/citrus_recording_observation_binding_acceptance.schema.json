{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citrus.recording_observation_binding_acceptance.v1",
  "title": "Citrus Recording Observation Binding Acceptance",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "canonicalization",
    "acceptance_id",
    "contract_sha256",
    "contract"
  ],
  "properties": {
    "schema_id": {
      "const": "citrus.recording_observation_binding_acceptance"
    },
    "schema_version": {"const": 1},
    "canonicalization": {
      "const": "canonical_json_utf8_sort_keys_compact_v1"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^obsbindacc_[0-9a-f]{64}$"
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"$ref": "#/$defs/contract"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f]$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "target": {
      "type": "object",
      "required": [
        "rig_id",
        "canvas_name",
        "arena_id",
        "camera_id",
        "source_camera_stream_id"
      ],
      "properties": {
        "rig_id": {"$ref": "#/$defs/identifier"},
        "canvas_name": {"$ref": "#/$defs/identifier"},
        "arena_id": {"$ref": "#/$defs/identifier"},
        "camera_id": {"$ref": "#/$defs/identifier"},
        "source_camera_stream_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "status",
        "request_id",
        "request_contract_sha256",
        "observation_context_id",
        "decided_at_utc",
        "citrus_experiment_id",
        "citrus_session_uuid",
        "target",
        "planned_h5_relative_path"
      ],
      "properties": {
        "schema_id": {
          "const": "citrus.recording_observation_binding_acceptance"
        },
        "schema_version": {"const": 1},
        "status": {"const": "accepted"},
        "request_id": {"type": "string", "pattern": "^obsbindreq_[0-9a-f]{64}$"},
        "request_contract_sha256": {"$ref": "#/$defs/sha256"},
        "observation_context_id": {"type": "string", "pattern": "^obsctx_[0-9a-f]{64}$"},
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "citrus_experiment_id": {"$ref": "#/$defs/identifier"},
        "citrus_session_uuid": {"$ref": "#/$defs/identifier"},
        "target": {"$ref": "#/$defs/target"},
        "planned_h5_relative_path": {"$ref": "#/$defs/relativePath"}
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "status",
        "request_id",
        "request_contract_sha256",
        "observation_context_id",
        "decided_at_utc",
        "reason"
      ],
      "properties": {
        "schema_id": {
          "const": "citrus.recording_observation_binding_acceptance"
        },
        "schema_version": {"const": 1},
        "status": {"const": "rejected"},
        "request_id": {"type": "string", "pattern": "^obsbindreq_[0-9a-f]{64}$"},
        "request_contract_sha256": {"$ref": "#/$defs/sha256"},
        "observation_context_id": {"type": "string", "pattern": "^obsctx_[0-9a-f]{64}$"},
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "reason": {
          "enum": [
            "identity_mismatch",
            "recording_pointer_mismatch",
            "recording_snapshot_mismatch",
            "target_mismatch",
            "geometry_mismatch",
            "output_path_mismatch",
            "runtime_authority_unavailable",
            "internal_error"
          ]
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "oneOf": [
        {"$ref": "#/$defs/accepted"},
        {"$ref": "#/$defs/rejected"}
      ]
    }
  }
}
