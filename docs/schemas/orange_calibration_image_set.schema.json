{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/orange_calibration_image_set.schema.json",
  "title": "orange.calibration.image_set",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "created_utc",
    "purpose",
    "target_plane",
    "coordinate_space",
    "camera",
    "capture",
    "images"
  ],
  "properties": {
    "schema_id": {
      "const": "orange.calibration.image_set"
    },
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "camera_arena_calibration_set",
        "arena_projection",
        "homography_grid",
        "scale_image",
        "dish_top_rim",
        "crosshair_alignment"
      ]
    },
    "target_plane": {
      "type": "string",
      "enum": [
        "multiple",
        "projected_surface",
        "tank_bottom_outer_surface",
        "tank_bottom_inner_surface",
        "estimated_fish_plane",
        "dish_top_rim",
        "unknown"
      ]
    },
    "coordinate_space": {
      "type": "string",
      "enum": [
        "camera_native_pixels",
        "camera_view_px"
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "serial",
        "image_shape"
      ],
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "image_shape": {
          "$ref": "#/$defs/image_shape"
        },
        "pixel_format": {
          "type": "string"
        },
        "configured_width": {
          "type": "integer",
          "minimum": 1
        },
        "configured_height": {
          "type": "integer",
          "minimum": 1
        },
        "camera_config_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "gpu_direct": {
          "type": "boolean"
        }
      }
    },
    "rig_context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rig_id": {
          "type": "string"
        },
        "canvas_id": {
          "type": "string"
        },
        "canvas_name": {
          "type": "string"
        },
        "arena_id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string"
        },
        "citrus_config_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "citrus_homography_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "tank_design_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "plane_stack_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "arena_context": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional Orange/Citrus association context for the camera/arena aggregate or linked specialized observation.",
          "properties": {
            "rig_id": {
              "type": "string"
            },
            "canvas_id": {
              "type": "string"
            },
            "arena_id": {
              "type": "string"
            },
            "camera_serial": {
              "type": "string"
            },
            "citrus_camera_id": {
              "type": "string"
            },
            "associated_image_set_artifact_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "timestamp_utc"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "capture_group_id": {
          "type": "string",
          "description": "Shared identifier for one operator-requested grouped capture across multiple cameras."
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "recording_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "source_frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "temporal_compositing_method": {
          "type": "string",
          "examples": [
            "temporal_mean_stream_frames_v1"
          ]
        },
        "first_local_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "last_local_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "first_camera_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "last_camera_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "capture_mode": {
          "type": "string"
        },
        "exposure_us": {
          "type": "number",
          "minimum": 0
        },
        "frame_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gain": {
          "type": "number"
        },
        "filter_state": {
          "type": "string"
        },
        "runtime_filter_state": {
          "type": "string"
        },
        "light_handling": {
          "type": "string",
          "examples": [
            "leave_current",
            "suppress_mapped_strobe",
            "keep_or_restore_mapped_pulse",
            "force_manual_active",
            "operator_manual"
          ]
        },
        "light_state": {
          "type": "string"
        },
        "illumination": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "spectrum": {
              "type": "string",
              "examples": [
                "narrowband_nir",
                "broadband_visible",
                "unknown_ir_nir",
                "none"
              ]
            },
            "source": {
              "type": "string",
              "examples": [
                "custom_ttl_nir_strobe",
                "visible_projector",
                "ambient_room_light"
              ]
            },
            "center_wavelength_nm": {
              "type": "number",
              "minimum": 0
            },
            "min_wavelength_nm": {
              "type": "number",
              "minimum": 0
            },
            "max_wavelength_nm": {
              "type": "number",
              "minimum": 0
            },
            "bandwidth_fwhm_nm": {
              "type": "number",
              "minimum": 0
            },
            "wavelength_confidence": {
              "type": "string",
              "examples": [
                "nominal",
                "measured",
                "approximate_range",
                "unknown"
              ]
            }
          }
        },
        "projector_state": {
          "type": "string"
        },
        "projector_visible_to_camera": {
          "type": "boolean"
        },
        "requires_camera_mount_unchanged": {
          "type": "boolean"
        },
        "requires_filter_reinstalled_repeatably": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/image_ref"
      }
    },
    "projected_pattern": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pattern_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "spacing_canvas_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dot_radius_canvas_px": {
          "type": "number",
          "minimum": 0
        },
        "canvas_coordinate_space": {
          "type": "string"
        },
        "expected_center_canvas_px": {
          "$ref": "#/$defs/point"
        },
        "expected_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "canvas_px": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "arena_relative_canvas_px": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "scale_target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "known_spacing_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "known_distance_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units": {
          "type": "string"
        },
        "target_plane": {
          "type": "string"
        },
        "target_plane_material": {
          "type": "string"
        }
      }
    },
    "runtime_role": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional hint describing how Citrus may use this physical target plane at runtime.",
      "properties": {
        "role": {
          "type": "string",
          "examples": [
            "behavior_plane_proxy"
          ]
        },
        "behavior_plane_id": {
          "type": "string",
          "examples": [
            "estimated_fish_plane"
          ]
        },
        "source": {
          "type": "string",
          "examples": [
            "fallback_to_tank_bottom_inner_surface"
          ]
        },
        "authority": {
          "type": "string",
          "examples": [
            "citrus_decides_runtime_application"
          ]
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "observed_domain": {
          "$ref": "#/$defs/calibration_domain"
        },
        "calibration_domain": {
          "$ref": "#/$defs/calibration_domain"
        },
        "authored_domain": {
          "$ref": "#/$defs/calibration_domain"
        },
        "homography_fit_intent": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "review_artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "linked_observations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Links from an aggregate camera/arena image set to specialized accepted observation artifacts.",
      "properties": {
        "accepted_top_rim_observation": {
          "$ref": "#/$defs/artifact_link"
        }
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "citrus_preview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "diagnostic_only": {
          "const": true
        },
        "authority": {
          "type": "string"
        }
      }
    },
    "operator_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "image_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "width"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "calibration_domain": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "shape",
        "coordinate_space"
      ],
      "properties": {
        "shape": {
          "type": "string",
          "examples": [
            "circle",
            "oriented_rectangle"
          ]
        },
        "source": {
          "type": "string"
        },
        "target_plane": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "string",
          "examples": [
            "camera_native_pixels",
            "final_display_canvas_px"
          ]
        },
        "center_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "radius_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation_deg_clockwise": {
          "type": "number"
        },
        "outer_geometry": {
          "type": "object",
          "additionalProperties": true
        },
        "valid_geometry": {
          "type": "object",
          "additionalProperties": true
        },
        "geometry_available": {
          "type": "boolean"
        },
        "authority": {
          "type": "string"
        },
        "edge_margin_px": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "image_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "role",
        "path",
        "checksum_algorithm",
        "checksum",
        "coordinate_space",
        "image_shape"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "checksum_algorithm": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_space": {
          "type": "string",
          "enum": [
            "camera_native_pixels",
            "camera_view_px"
          ]
        },
        "image_shape": {
          "$ref": "#/$defs/image_shape"
        },
        "purpose": {
          "type": "string"
        },
        "target_plane": {
          "type": "string"
        },
        "capture": {
          "type": "object",
          "additionalProperties": true
        },
        "projected_pattern": {
          "type": "object",
          "additionalProperties": true
        },
        "scale_target": {
          "type": "object",
          "additionalProperties": true
        },
        "description": {
          "type": "string"
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_id",
        "artifact_schema_id",
        "artifact_schema_version"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "artifact_link": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_id",
        "artifact_schema_id",
        "artifact_schema_version"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string"
        },
        "relative_manifest_path": {
          "type": "string"
        },
        "relative_observation_path": {
          "type": "string"
        },
        "selection_policy": {
          "type": "string"
        },
        "target_plane": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "string"
        },
        "camera_serial": {
          "type": "string"
        },
        "arena_id": {
          "type": "string"
        },
        "canvas_id": {
          "type": "string"
        },
        "arena_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
