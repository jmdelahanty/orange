{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.recording_empty_background.v1",
  "title": "Orange recording empty-background binding (start-snapshot block; version 1 DRAFT)",
  "description": "DRAFT 2026-11-02. recording_snapshot_start.json session.empty_background, written on EVERY recording. capture_selected false means no capture was offered or the operator chose none: every recording camera is then not_selected (a declared absence). Otherwise the capture's descriptor is copied byte for byte to empty_background/background.json and each camera's median to empty_background/<image.relative_path>, for attached AND settings_changed cameras (Jeremy 2026-11-02: a settings drift is copied and flagged, never dropped; Palette refuses it unless the consumer handles the listed differences). cameras is keyed by exact camera serial, one entry per recording camera, so every image in the recording copy maps to exactly one status. Frame rate is recorded in the descriptor and not checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_selected",
    "cameras"
  ],
  "properties": {
    "capture_selected": {
      "type": "boolean"
    },
    "selection_source": {
      "enum": [
        "gui_operator",
        "headless_spec"
      ]
    },
    "scene_unchanged_confirmed": {
      "const": true,
      "description": "GUI: the operator confirmed per recording that the scene is unchanged since the capture apart from adding the fish. Headless: naming the capture in the spec is the confirmation."
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "source_descriptor_path": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+(?![\\s\\S])"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "const": "empty_background/background.json"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "cameras": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "attached",
              "settings_changed",
              "not_selected",
              "missing_in_capture",
              "copy_failed"
            ]
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "pattern": "^Cam[A-Za-z0-9_-]+_empty_background\\.png(?![\\s\\S])"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "description": "PNG, 8-bit greyscale, no alpha, no gAMA/iCCP/sRGB chunks; IHDR width/height equal camera_configuration."
          },
          "settings_differences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "setting",
                "capture_value",
                "recording_value"
              ],
              "properties": {
                "setting": {
                  "enum": [
                    "exposure_us",
                    "gain",
                    "iris",
                    "focus",
                    "width",
                    "height",
                    "offset_x",
                    "offset_y"
                  ]
                },
                "capture_value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "recording_value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              },
              "description": "pixel_format is Mono8 on both sides by schema, so it never appears here."
            }
          },
          "failure_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "attached"
                }
              }
            },
            "then": {
              "required": [
                "image"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "attached"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "settings_differences"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "attached"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "settings_changed"
                }
              }
            },
            "then": {
              "required": [
                "image",
                "settings_differences"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "settings_changed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_selected"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "image"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_selected"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "settings_differences"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_selected"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "missing_in_capture"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "image"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "missing_in_capture"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "settings_differences"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "copy_failed"
                }
              }
            },
            "then": {
              "required": [
                "failure_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "copy_failed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "image"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "copy_failed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "settings_differences"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "selection_source",
          "scene_unchanged_confirmed",
          "capture_id",
          "source_descriptor_path",
          "descriptor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "selection_source"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "scene_unchanged_confirmed"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "capture_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "source_descriptor_path"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_selected": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "descriptor"
          ]
        }
      }
    }
  ]
}
