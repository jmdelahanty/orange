{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citrus.recording_observation_binding_acceptance.v2",
  "title": "Citrus Recording Observation Binding Acceptance (v2: recording-context reconciliation reasons, batch_rejected)",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "canonicalization",
    "acceptance_id",
    "contract_sha256",
    "contract"
  ],
  "properties": {
    "schema_id": {
      "const": "citrus.recording_observation_binding_acceptance"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "canonicalization": {
      "const": "canonical_json_utf8_sort_keys_compact_v1"
    },
    "acceptance_id": {
      "type": "string",
      "pattern": "^obsbindacc_[0-9a-f]{64}$"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f]$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "target": {
      "type": "object",
      "required": [
        "rig_id",
        "canvas_name",
        "arena_id",
        "camera_id",
        "source_camera_stream_id"
      ],
      "properties": {
        "rig_id": {
          "$ref": "#/$defs/identifier"
        },
        "canvas_name": {
          "$ref": "#/$defs/identifier"
        },
        "arena_id": {
          "$ref": "#/$defs/identifier"
        },
        "camera_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_camera_stream_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "status",
        "request_id",
        "request_contract_sha256",
        "observation_context_id",
        "decided_at_utc",
        "citrus_experiment_id",
        "citrus_session_uuid",
        "target",
        "planned_h5_relative_path"
      ],
      "properties": {
        "schema_id": {
          "const": "citrus.recording_observation_binding_acceptance"
        },
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "status": {
          "const": "accepted"
        },
        "request_id": {
          "type": "string",
          "pattern": "^obsbindreq_[0-9a-f]{64}$"
        },
        "request_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_context_id": {
          "type": "string",
          "pattern": "^obsctx_[0-9a-f]{64}$"
        },
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "citrus_experiment_id": {
          "$ref": "#/$defs/identifier"
        },
        "citrus_session_uuid": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "planned_h5_relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "status",
        "request_id",
        "request_contract_sha256",
        "observation_context_id",
        "decided_at_utc",
        "reason"
      ],
      "properties": {
        "schema_id": {
          "const": "citrus.recording_observation_binding_acceptance"
        },
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "status": {
          "const": "rejected"
        },
        "request_id": {
          "type": "string",
          "pattern": "^obsbindreq_[0-9a-f]{64}$"
        },
        "request_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_context_id": {
          "type": "string",
          "pattern": "^obsctx_[0-9a-f]{64}$"
        },
        "decided_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "reason": {
          "enum": [
            "identity_mismatch",
            "recording_pointer_mismatch",
            "recording_snapshot_mismatch",
            "target_mismatch",
            "geometry_mismatch",
            "output_path_mismatch",
            "runtime_authority_unavailable",
            "internal_error",
            "recording_context_missing",
            "recording_context_invalid",
            "recording_context_mismatch",
            "recording_context_unavailable",
            "batch_rejected"
          ],
          "description": "v2 adds recording_context_* (the request's frozen context is missing, invalid, differs from the configured Arena context, or Citrus has no configured expectation) and batch_rejected (an otherwise-valid sibling refused only because another member of the atomic batch was rejected)."
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "oneOf": [
        {
          "$ref": "#/$defs/accepted"
        },
        {
          "$ref": "#/$defs/rejected"
        }
      ]
    }
  }
}
