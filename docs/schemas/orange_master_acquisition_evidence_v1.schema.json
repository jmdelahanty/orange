{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Headless acquisition master journal prearm or parent completion evidence v1",
  "oneOf": [{"$ref": "#/$defs/start"}, {"$ref": "#/$defs/completion"}],
  "$defs": {
    "serial": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 1024},
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^Cam[A-Za-z0-9_-]+_master_frames_v1\\.(csv|json)(?![\\s\\S])"},
        "size_bytes": {"$ref": "#/$defs/uint64"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
      }
    },
    "start": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "required", "profile", "config", "cameras"],
      "properties": {
        "schema_version": {"const": 1},
        "required": {"const": true},
        "profile": {"const": "headless_acquisition_loop_v1"},
        "config": {"$ref": "orange_master_acquisition_config_v1.schema.json"},
        "cameras": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["camera_serial", "recording_id", "producer_instance_id", "stream_generation", "descriptor_relative_path"],
            "properties": {
              "camera_serial": {"$ref": "#/$defs/serial"},
              "recording_id": {"$ref": "#/$defs/identity"},
              "producer_instance_id": {"$ref": "#/$defs/identity"},
              "stream_generation": {"$ref": "#/$defs/uint64"},
              "descriptor_relative_path": {"type": "string", "pattern": "^Cam[A-Za-z0-9_-]+_master_frames_v1\\.json(?![\\s\\S])"}
            }
          }
        }
      }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "required", "profile", "status", "cameras"],
      "properties": {
        "schema_version": {"const": 1},
        "required": {"const": true},
        "profile": {"const": "headless_acquisition_loop_v1"},
        "status": {"enum": ["pending", "complete", "failed"]},
        "reason": {"type": "string", "minLength": 1},
        "cameras": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["camera_serial", "descriptor", "csv"],
            "properties": {
              "camera_serial": {"$ref": "#/$defs/serial"},
              "descriptor": {"$ref": "#/$defs/asset"},
              "csv": {"$ref": "#/$defs/asset"}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "complete"}}},
         "then": {"properties": {"cameras": {"minItems": 1}}, "not": {"required": ["reason"]}}},
        {"if": {"properties": {"status": {"const": "pending"}}},
         "then": {"properties": {"cameras": {"maxItems": 0}}, "not": {"required": ["reason"]}}},
        {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["reason"]}}
      ]
    }
  }
}
