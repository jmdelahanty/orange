{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.recording.image_levels_check.v3",
  "title": "Orange recording image-levels check (version 3)",
  "description": "recording_snapshot_start.json session.image_levels_check: brightness and saturation of one full-resolution native Mono8 frame per recording camera, measured by the GUI 2 s after the stream delivers frames and again right after every recording (never during one: the copy reads the landing die), over the whole image (statistics, orange.image_levels.v1) and inside the dish (dish_interior, orange.image_levels_dish_interior.v1), against the expectation in each camera's config file (camera JSON image_levels, orange.camera.image_levels v2; a v1 block is reported as v2 with region whole_frame). checked_region says which statistics the warnings judge. At stream start (and on the operator's Measure now) a mean out of band re-homes the EF iris once (0, then the configured value) and measures again; the after-recording re-measure never re-homes. Each record start seals the newest finished measurement with measurement_trigger, its age at the start (measurement_age_s) and its freshness: fresh when it was measured after the previous recording in this process ended, is at most fresh_max_age_s old, and no newer measurement was in progress; otherwise stale with stale_reasons. The start never waits for a measurement. v3 adds fresh_max_age_s, measurement_trigger, measurement_age_s, freshness and stale_reasons to v2; nothing else changed. Policy warn_only: the check never refuses a stream or a recording. Written by src/image_levels.cpp (ResultStore::BuildRecordingBlockAt) from src/gui/image_levels_check.cpp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "policy",
    "enabled",
    "rehome_iris",
    "source",
    "fresh_max_age_s",
    "cameras"
  ],
  "properties": {
    "schema_id": {
      "const": "orange.recording.image_levels_check"
    },
    "schema_version": {
      "const": 3
    },
    "policy": {
      "const": "warn_only"
    },
    "enabled": {
      "type": "boolean"
    },
    "rehome_iris": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "fresh_max_age_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "A sealed measurement older than this (seconds) is stale (older_than_max_age)."
    },
    "cameras": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      },
      "description": "Per recording camera serial."
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "gain",
        "iris",
        "focus",
        "width",
        "height",
        "offset_x",
        "offset_y"
      ],
      "properties": {
        "exposure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "iris": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "focus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offset_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "offset_y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "Camera settings as CameraParams holds them (unsigned integers): exposure in microseconds, gain and iris and focus in camera units, the AOI in sensor pixels."
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "warnings",
        "expectation",
        "expectation_basis_settings_differ",
        "live_settings",
        "measurement",
        "first_measurement",
        "rehomed_iris",
        "not_measured_reason",
        "settings_changed_since_measurement",
        "checked_region",
        "measurement_trigger",
        "measurement_age_s",
        "freshness",
        "stale_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "warning",
            "no_expectation",
            "measurement_failed",
            "not_measured"
          ],
          "description": "ok: every configured check passed; warning: at least one failed (see warnings); no_expectation: measured, but the camera config has no image_levels block; measurement_failed: the native frame or its copy failed; not_measured: see not_measured_reason. dish_interior_unavailable (a warning): the expectation checks the dish interior but the measurement has no dish region."
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "mean_out_of_band",
              "saturated_fraction_above_limit",
              "dish_interior_unavailable"
            ]
          },
          "uniqueItems": true
        },
        "expectation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "orange.camera.image_levels.v2"
            }
          ],
          "description": "The camera config's image_levels block as loaded at the time of the check, written as version 2 (orange_camera_image_levels_v2.schema.json)."
        },
        "expectation_basis_settings_differ": {
          "type": "array",
          "items": {
            "enum": [
              "exposure",
              "gain",
              "iris",
              "focus",
              "width",
              "height",
              "offset_x",
              "offset_y"
            ]
          },
          "uniqueItems": true,
          "description": "Settings recorded in the expectation's basis.settings that differ from live_settings."
        },
        "live_settings": {
          "$ref": "#/$defs/settings"
        },
        "measurement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "measured_at_utc",
                    "source",
                    "native_source_storage",
                    "camera_frame_id",
                    "camera_timestamp_ns",
                    "timestamp_sys_ns",
                    "settings",
                    "statistics",
                    "dish_interior"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "measured_at_utc": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "const": "full_resolution_native_stream_snapshot"
                    },
                    "native_source_storage": {
                      "enum": [
                        "analytics_owned_device",
                        "pool_owned_ring_device"
                      ]
                    },
                    "camera_frame_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "camera_timestamp_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "timestamp_sys_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "settings": {
                      "$ref": "#/$defs/settings"
                    },
                    "statistics": {
                      "$ref": "orange.image_levels.v1"
                    },
                    "dish_interior": {
                      "$ref": "orange.image_levels_dish_interior.v1"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "error",
                    "measured_at_utc"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1
                    },
                    "measured_at_utc": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          ],
          "description": "The measurement the status is judged on (after an iris re-home, the second one)."
        },
        "first_measurement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "measured_at_utc",
                    "source",
                    "native_source_storage",
                    "camera_frame_id",
                    "camera_timestamp_ns",
                    "timestamp_sys_ns",
                    "settings",
                    "statistics",
                    "dish_interior"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "measured_at_utc": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "const": "full_resolution_native_stream_snapshot"
                    },
                    "native_source_storage": {
                      "enum": [
                        "analytics_owned_device",
                        "pool_owned_ring_device"
                      ]
                    },
                    "camera_frame_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "camera_timestamp_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "timestamp_sys_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "settings": {
                      "$ref": "#/$defs/settings"
                    },
                    "statistics": {
                      "$ref": "orange.image_levels.v1"
                    },
                    "dish_interior": {
                      "$ref": "orange.image_levels_dish_interior.v1"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "error",
                    "measured_at_utc"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1
                    },
                    "measured_at_utc": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          ],
          "description": "The out-of-band measurement that triggered the iris re-home, when rehomed_iris is true."
        },
        "rehomed_iris": {
          "type": "boolean"
        },
        "not_measured_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when status is not_measured: disabled_in_app_config, not_streaming, recording_started_before_measurement, no_check_result, or measurement_in_progress_<phase>."
        },
        "settings_changed_since_measurement": {
          "type": "array",
          "items": {
            "enum": [
              "exposure",
              "gain",
              "iris",
              "focus",
              "width",
              "height",
              "offset_x",
              "offset_y"
            ]
          },
          "uniqueItems": true,
          "description": "Settings that changed between the measurement and the record start."
        },
        "checked_region": {
          "enum": [
            null,
            "dish_interior",
            "whole_frame"
          ],
          "description": "The region the expectation checks; null without an expectation."
        },
        "measurement_trigger": {
          "enum": [
            null,
            "stream_start",
            "operator",
            "after_recording"
          ],
          "description": "What started the sealed measurement: the check after stream start, the operator's Measure now, or the re-measure after the previous recording; null without a finished check (not streaming, disabled, no result, or the first check still in progress)."
        },
        "measurement_age_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Seconds from the measurement to this record start (3 decimals); null without a measurement."
        },
        "freshness": {
          "enum": [
            null,
            "fresh",
            "stale"
          ],
          "description": "fresh: measured for this recording (see the block description); stale: see stale_reasons; null without a measurement."
        },
        "stale_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "measured_before_previous_recording",
              "older_than_max_age",
              "refresh_in_progress"
            ]
          },
          "description": "measured_before_previous_recording: an earlier recording in this process ended after the measurement (its re-measure had not finished or had to give way to this start); older_than_max_age: measurement_age_s > fresh_max_age_s; refresh_in_progress: a newer measurement was under way at the start. Empty when fresh or without a measurement."
        }
      }
    }
  }
}
