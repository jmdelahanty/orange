{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate unbound daily-registration native context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "capture_id",
    "requested_at_utc",
    "status",
    "scope",
    "recording_binding",
    "coordinate_space",
    "camera_configuration_authority",
    "housekeeping_cpu",
    "scene_declaration",
    "registration_id",
    "source_registration_path",
    "registration",
    "geometry",
    "runtime_before",
    "runtime_after",
    "cameras"
  ],
  "properties": {
    "schema_id": {
      "const": "orange.calibration.registered_native_context"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "requested_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "captured"
    },
    "scope": {
      "const": "daily_registration"
    },
    "recording_binding": {
      "const": "unbound"
    },
    "coordinate_space": {
      "const": "camera_native_pixels"
    },
    "camera_configuration_authority": {
      "const": "orange_runtime_configuration"
    },
    "housekeeping_cpu": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "scene_declaration": {
      "allOf": [
        {
          "$ref": "orange_registered_context_capture_declaration_v1.schema.json"
        },
        {
          "properties": {
            "registration_authority_status": {
              "const": "accepted_for_experiment"
            }
          }
        }
      ]
    },
    "registration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source_registration_path": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+(?![\\s\\S])"
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "const": "registration.json"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "const": "geometry.json"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "runtime_before": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "const": "runtime_before.json"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "runtime_after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "const": "runtime_after.json"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera_serial",
          "camera_configuration",
          "source_storage",
          "stride_bytes",
          "image",
          "source_frame"
        ],
        "properties": {
          "camera_serial": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
          },
          "camera_configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "camera_id",
              "width",
              "height",
              "pixel_format",
              "frame_rate_hz",
              "exposure_us",
              "gain",
              "focus",
              "iris"
            ],
            "properties": {
              "camera_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "pixel_format": {
                "const": "Mono8"
              },
              "frame_rate_hz": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "exposure_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "gain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "focus": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "iris": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          },
          "source_storage": {
            "enum": [
              "analytics_owned_device",
              "pool_owned_ring_device"
            ]
          },
          "stride_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "pattern": "^Cam[A-Za-z0-9_-]+_native\\.raw(?![\\s\\S])"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "source_frame": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_frame_id",
              "camera_frame_id",
              "recording_frame_id",
              "camera_timestamp_ns",
              "timestamp_sys_ns"
            ],
            "properties": {
              "local_frame_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              },
              "camera_frame_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "recording_frame_id": {
                "type": "integer",
                "const": 0
              },
              "camera_timestamp_ns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              },
              "timestamp_sys_ns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              }
            }
          }
        }
      }
    }
  }
}
