{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.recording.observation_binding_request_collection.v1",
  "title": "Orange Recording Observation Binding Request Collection",
  "type": "object",
  "required": ["schema_id", "schema_version", "status", "binding_mode", "recording_id", "recording_snapshot", "recording_geometry_contract", "request_count", "requests"],
  "properties": {
    "schema_id": {"const": "orange.recording.observation_binding_request_collection"},
    "schema_version": {"const": 1},
    "status": {"const": "materialized"},
    "binding_mode": {"enum": ["required", "optional"]},
    "recording_id": {"type": "string", "minLength": 1},
    "recording_snapshot": {
      "type": "object",
      "required": ["role", "relative_path", "sha256"],
      "properties": {
        "role": {"const": "immutable_recording_start_snapshot"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "recording_geometry_contract": {"$ref": "#/$defs/artifactReference"},
    "request_count": {"type": "integer", "minimum": 1},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requestReference"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "artifactReference": {
      "type": "object",
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "requestReference": {
      "type": "object",
      "required": ["observation_context_id", "observation_identity_sha256", "observation_identity", "request_id", "request_contract_sha256", "relative_path", "sha256", "byte_size"],
      "properties": {
        "observation_context_id": {"type": "string", "pattern": "^obsctx_[0-9a-f]{64}$"},
        "observation_identity_sha256": {"$ref": "#/$defs/sha256"},
        "observation_identity": {"$ref": "orange_recording_observation_identity.schema.json"},
        "request_id": {"type": "string", "pattern": "^obsbindreq_[0-9a-f]{64}$"},
        "request_contract_sha256": {"$ref": "#/$defs/sha256"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
