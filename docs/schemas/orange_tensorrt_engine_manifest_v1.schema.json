{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.tensorrt_engine_manifest.v1",
  "title": "Orange TensorRT engine manifest (version 1)",
  "description": "`<stem>.manifest.json` written beside every TensorRT engine Orange runs (detect: scripts/write_tensorrt_engine_manifest.py; pose: scripts/write_pose_tensorrt_engine_manifest.py). Identifies the engine by content (engine.sha256), its sources (ONNX, weights, manifests), the build (trtexec, TensorRT version, builder GPU, options, and since 2026-10-09 build.environment with host / driver / CUDA toolkit) and, for INT8 engines, the calibration (calibrator, cache and record digests, frames). The recording snapshot's models.<serial>.<detect|pose>.runtime.engine_manifest names this file by path and sha256. Published 2026-10-09 for Palette to pin; closed at the top level and in the engine, source, build, build.selected_gpu, build.environment and build.int8_calibration blocks; the task-specific blocks are optional and left open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "created_at_utc",
    "status",
    "deployment_runtime",
    "target_hardware_class",
    "palette_run_id",
    "source",
    "engine",
    "precision",
    "build"
  ],
