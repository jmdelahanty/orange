{
  "schema_id": "orange.encoding_master_experiment.manifest",
  "schema_version": 1,
  "experiment_id": "encoding_master_singlecam_60fps_two_encoder_lossless",
  "notes": "Single-camera 60 fps external IPC two-encoder lossless discriminator. This tests whether lossless GOP=1 remains sustainable when one camera gets exactly two external encoder shards.",
  "defaults": {
    "artifact_root": "/tmp/orange_encoding_master",
    "analytics_output_root": "/home/jeremy/orange_data/exp/unsorted",
    "duration_s": 6,
    "warmup_s": 1,
    "orange_client": "/home/jeremy/orange-gop-split-a16/targets/release/orange_client",
    "benchmark": "/usr/local/bin/orange-local-benchmark",
    "sudo": true,
    "verify_external_recorder": true,
    "yolo_perf_log": true,
    "yolo_perf_sample": 1
  },
  "runs": [
