      "stream_overrides": {
        "2010096": {
          "expected_shard_gpu_ids": [5, 6],
          "routing_policy": "gop_modulo",
          "preset": "p1",
          "tuning": "lossless",
          "rate_control_mode": "cqp",
          "quality_value": 0,
          "gop": 1,
          "encode_queue_depth": 32,
          "encode_fps": 60,
          "encode_max_fps": 0
