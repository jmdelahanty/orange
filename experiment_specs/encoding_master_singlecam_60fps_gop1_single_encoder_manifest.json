  "experiment_id": "encoding_master_singlecam_60fps_gop1_single_encoder",
  "notes": "Single-camera 60 fps external IPC GOP=1 discriminator using one external encoder shard. This tests whether P5/P7 HQ can sustain all-intra style GOP=1 recording without split-GOP fanout across multiple encoder GPUs.",
  "defaults": {
    "artifact_root": "/tmp/orange_encoding_master",
    "analytics_output_root": "/home/jeremy/orange_data/exp/unsorted",
    "duration_s": 6,
    "warmup_s": 1,
    "orange_client": "/home/jeremy/orange-gop-split-a16/targets/release/orange_client",
    "benchmark": "/usr/local/bin/orange-local-benchmark",
    "sudo": true,
    "verify_external_recorder": true,
    "yolo_perf_log": true,
    "yolo_perf_sample": 1
  },
  "runs": [
    {
      "run_id": "single_encoder_gop1_p5_hq_vbr150",
