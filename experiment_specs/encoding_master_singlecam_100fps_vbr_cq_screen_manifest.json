{
  "schema_id": "orange.encoding_master_experiment.manifest",
  "schema_version": 1,
  "experiment_id": "encoding_master_singlecam_100fps_vbr_cq_screen",
  "notes": "First-stage live-fish screen of the production external recorder at 4512x4512 and 100 fps. This compares the current P1 VBR 150 Mbps control against integer NVENC P1 VBR-CQ targets 18, 20, 22, and 24 with a 250 Mbps maximum/VBV ceiling. Two targeted P3 rows repeat the VBR control and CQ20 so preset effects can be screened at both a fixed bitrate and a fixed quality target without doubling the full CQ ladder. The registered-dish QP map is explicitly off in every run. Because these are sequential live acquisitions rather than replay of one immutable source, use the results to reject unstable or clearly poor settings; do not treat small between-run quality differences as definitive without a later identical-source replay or balanced repetitions.",
  "defaults": {
    "camera_serials": ["2010096"],
    "analytics_gpu_id": 7,
    "artifact_root": "/home/jeremy/orange_data/benchmarks/encoding_quality",
    "analytics_output_root": "/home/jeremy/orange_data/exp/unsorted",
    "duration_s": 15,
    "warmup_s": 2,
    "orange_client": "/home/jeremy/orange-gop-split-a16/targets/release/orange_client",
    "benchmark": "/usr/local/bin/orange-local-benchmark",
    "sudo": true,
    "verify_external_recorder": true,
    "yolo_perf_log": true,
    "yolo_perf_sample": 1
  },
  "runs": [
    {
      "run_id": "vbr150_control",
      "stage": "rate_control_screen",
      "description": "Current production control: P1 LL VBR 150 Mbps, GOP 25, QP map off.",
