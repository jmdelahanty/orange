      "tags": ["control", "vbr", "map_off"],
      "stream_overrides": {
        "2010096": {
          "preset": "p1",
          "rate_control_mode": "vbr",
          "quality_value": 20,
          "bitrate_bps": 150000000,
          "max_bitrate_bps": 150000000,
          "vbv_buffer_size": 150000000,
          "importance_map": {"mode": "off"}
        }
      },
      "matrix_overrides": {
        "preset": ["p1"],
        "rate_control_mode": ["vbr"],
        "quality_value": [20],
        "target_bitrate_bps": [150000000],
        "max_bitrate_bps": [150000000],
        "vbv_buffer_size": [150000000],
        "importance_map_mode": ["off"]
