  "focus_uart_bootstrap": true,
  "color": false,
  "offset_x": 0,
  "offset_y": 0,
  "sync_mode": "free_run",
  "trigger": {
    "enabled": false,
    "selector": "AcquisitionStart",
    "source": "Software",
    "activation": "RisingEdge"
